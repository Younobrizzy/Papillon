# Keep conventional root icon URLs available for browsers and crawlers while assets live under assets/icons.
/favicon.ico /assets/icons/favicon.ico 200
/favicon.svg /assets/icons/favicon.svg 200
/favicon-16x16.png /assets/icons/favicon-16x16.png 200
/favicon-32x32.png /assets/icons/favicon-32x32.png 200
/favicon-48x48.png /assets/icons/favicon-48x48.png 200
/apple-touch-icon.png /assets/icons/apple-touch-icon.png 200
/icon-192.png /assets/icons/icon-192.png 200
/icon-512.png /assets/icons/icon-512.png 200
/site.webmanifest /assets/icons/site.webmanifest 200

# Make the folder-based dashboard URL canonical without rewriting to index.html.
/dashboard /dashboard/ 301

# Canonical shipping policy URL.
/shipping /shipping/ 301

# Puppy contact URLs are rewritten by functions/_middleware.js because Pages
# _redirects rules are not applied when a Pages Function handles the request.

# All puppy profile routes use the shared Firestore-powered template.
# Newly created listing slugs use the shared puppy template. The extensionless target avoids Pages clean-URL loops.
/:slug /puppy 200

# Cloudflare Pages serves the root 404.html automatically for unmatched paths; no wildcard rule is needed.
