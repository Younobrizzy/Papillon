rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All Papillon Firestore access goes through Cloudflare Pages Functions using
    // a server-side service account. Firebase client SDKs should not read or
    // write documents directly. The service account bypasses these client rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
